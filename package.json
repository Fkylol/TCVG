    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:cards": "node --env-file=.env --import tsx scripts/db-cards.ts",
    "db:genres": "node --env-file=.env --import tsx scripts/cards-genres.ts",
    "db:verify": "node --env-file=.env --import tsx scripts/db-verify.ts",
    "db:admin": "node --env-file=.env --import tsx scripts/db-admin.ts",
    "db:frames": "node --env-file=.env --import tsx scripts/db-frames.ts",
    "db:frames:verify": "node --env-file=.env --import tsx scripts/db-frames-verify.ts",
    "db:chat:seed": "node --env-file=.env --import tsx scripts/db-chat-seed.ts",
    "images:sync": "node --env-file=.env --import tsx scripts/cards-images.ts",
    "images:check": "node --env-file=.env --import tsx scripts/images/check.ts",
    "images:fix": "node --env-file=.env --import tsx scripts/images/fix.ts",
    "popularity:check-env": "node --env-file=.env --import tsx scripts/popularity/check-env.ts",
    "popularity:snapshot": "node --env-file=.env --import tsx scripts/popularity/snapshot.ts",
