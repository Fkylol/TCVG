    "popularity:fetch": "node --env-file=.env --import tsx scripts/popularity/fetch.ts",
    "popularity:score": "node --env-file=.env --import tsx scripts/popularity/score.ts",
    "rarity:preview": "node --env-file=.env --import tsx scripts/popularity/preview.ts",
    "rarity:apply": "node --env-file=.env --import tsx scripts/popularity/apply.ts",
