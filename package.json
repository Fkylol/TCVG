    "images:strict": "node --env-file=.env --import tsx scripts/images/strict.ts",
    "images:cleanup": "node --env-file=.env --import tsx scripts/images/cleanup.ts",
    "images:refill": "node --env-file=.env --import tsx scripts/images/refill.ts"
