# ═══════════════════════════════════════════════════════════════
#  1. APPLICATION — lues par Next.js (dev et runtime)
#     Copie ce fichier vers .env.local puis remplis les valeurs.
# ═══════════════════════════════════════════════════════════════

# URL publique du site, utilisée pour les liens de partage (og:image).
# Facultatif : l'URL de production est utilisée par défaut.
# NEXT_PUBLIC_SITE_URL=https://tcvg.fkylol.workers.dev

# Notifications des avis et bugs (Resend → API Keys).
# La clé ne se met JAMAIS dans wrangler.jsonc : en production, c'est un secret
# (`npx wrangler secret put RESEND_API_KEY`), en local une variable de .env.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Adresse qui reçoit les messages (obligatoirement l'adresse du compte tant
# qu'aucun domaine n'est vérifié sur Resend).
# FEEDBACK_EMAIL_TO=toi@example.com
# Expéditeur, une fois un domaine vérifié : "TCVG <avis@ton-domaine>"
# FEEDBACK_EMAIL_FROM=TCVG <onboarding@resend.dev>

# Messages privés Discord des propositions d'échange (facultatif).
# Discord → ton application → Bot → Reset Token. Le bot doit être invité sur le
# serveur du jeu : Discord n'ouvre un MP qu'avec un membre qui partage un
# serveur avec lui. Sans jeton, seul l'avis dans le site est créé.
# DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Liaison des comptes : la migration 045 enregistre l'identifiant Discord fourni
# par la connexion OAuth dans `discord_links` (table illisible depuis le client).
# Son déclencheur lit `auth.identities` : rien à faire côté code.
#
# La clé de service est aussi nécessaire pour lire `discord_links` depuis le
# serveur. Elle contourne RLS : jamais dans du code client.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Parrainage — sel secret des empreintes d'IP et d'agent utilisateur.
# Génère-le avec `openssl rand -hex 32` ; sans lui, aucune empreinte n'est
# écrite (le parrainage fonctionne, la détection même-IP est désactivée).
# REFERRAL_HASH_SALT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret des tâches planifiées /api/cron/referrals (horaire) et
# /api/cron/frames (quotidienne), en-tête Authorization: Bearer ….
# Sans lui, les endpoints répondent 503. /api/cron/frames exige aussi
# SUPABASE_SERVICE_ROLE_KEY.
# CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → Project API keys → anon / public
# (jamais la clé service_role ici : elle contourne toutes les policies RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ═══════════════════════════════════════════════════════════════
#  1 bis. MIGRATIONS — connexion Postgres directe
#     Uniquement pour `npm run db:migrate` (appliquer supabase/schema.sql).
#     PostgREST (clé anon ou service_role) ne peut pas exécuter de DDL.
#     Supabase → Project Settings → Database → Connection string → URI
#     (préférer le « Session pooler » si le direct est injoignable).
#     ⚠ Contient le mot de passe de la base : local uniquement.
# ═══════════════════════════════════════════════════════════════

# SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:motdepasse@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Overlay Halloween : 0 en production, 1 pour le tester hors du 15 octobre–2 novembre.
# NEXT_PUBLIC_ est lue au build par le navigateur ; HALLOWEEN_FORCE par la route.
NEXT_PUBLIC_HALLOWEEN_FORCE=0
HALLOWEEN_FORCE=0

# Overlay Noël : 0 en production, 1 pour le tester hors du 1er décembre–5 janvier.
NEXT_PUBLIC_XMAS_FORCE=0

# ═══════════════════════════════════════════════════════════════
#  2. DÉPLOIEMENT CLOUDFLARE — CLI wrangler uniquement
#     Ces valeurs ne sont JAMAIS lues par l'application : ne les mets pas
#     dans .env.local. Exporte-les dans ton shell ou dans les secrets de la CI.
#
#     Cloudflare Dashboard → My Profile → API Tokens → Create Token
#     → template « Edit Cloudflare Workers »
#     L'Account ID est sur la page d'accueil du dashboard (colonne de droite),
#     ou via `npx wrangler whoami` après `npx wrangler login`.
# ═══════════════════════════════════════════════════════════════

# CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
#  3. GIT — aucune variable d'environnement
#     Rien à mettre ici : l'authentification passe par SSH
#     (`git remote add origin git@github.com:Fkylol/<repo>.git`) ou par
#     `gh auth login`. Un token de dépôt n'a pas sa place dans ce fichier.
# ═══════════════════════════════════════════════════════════════
