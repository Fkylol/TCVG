# ═══════════════════════════════════════════════════════════════
#  1. APPLICATION — lues par Next.js (dev et runtime)
#     Copie ce fichier vers .env.local puis remplis les valeurs.
# ═══════════════════════════════════════════════════════════════

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → Project API keys → anon / public
# (jamais la clé service_role ici : elle contourne toutes les policies RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ═══════════════════════════════════════════════════════════════
#  2. DÉPLOIEMENT CLOUDFLARE — CLI wrangler uniquement
#     Ces valeurs ne sont JAMAIS lues par l'application : ne les mets pas
#     dans .env.local. Exporte-les dans ton shell ou dans les secrets de la CI.
#
#     Cloudflare Dashboard → My Profile → API Tokens → Create Token
#     → template « Edit Cloudflare Workers »
#     L'Account ID est sur la page d'accueil du dashboard (colonne de droite),
#     ou via `npx wrangler whoami` après `npx wrangler login`.
# ═══════════════════════════════════════════════════════════════

# CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
#  3. GIT — aucune variable d'environnement
#     Rien à mettre ici : l'authentification passe par SSH
#     (`git remote add origin git@github.com:Fkylol/<repo>.git`) ou par
#     `gh auth login`. Un token de dépôt n'a pas sa place dans ce fichier.
# ═══════════════════════════════════════════════════════════════
